# ========== Environment & Debug ==========
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ========== OpenAI LLM Configuration ==========
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4.1-mini
QUERY_TRANSFORM_MODEL=gpt-4.1-nano-2025-04-14
OPENAI_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Azure OpenAI (Alternative)
USE_AZURE_OPENAI=false
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_LLM_DEPLOYMENT=gpt-4.1-mini
AZURE_QUERY_TRANSFORM_DEPLOYMENT=  # optional; falls back to AZURE_LLM_DEPLOYMENT

# Token limits & Cost control
MAX_QUERY_TOKENS=256
MAX_CONTEXT_TOKENS=4000
MAX_RESPONSE_TOKENS=1024
API_TIMEOUT_SECONDS=30
MAX_RESPONSE_CHARS=50000
MAX_QUERY_CHARS=2000

# ========== Ollama (Optional Local LLM) ==========
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ========== Qdrant Vector Database ==========
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=qdrant-dev-key
QDRANT_COLLECTION_NAME=german-visa-docs
QDRANT_VECTOR_SIZE=1536
QDRANT_PREFER_GRPC=false

# ========== Redis Cache ==========
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
ENABLE_QUERY_CACHE=true

# ========== SQLite State Store ==========
SQLITE_DB_PATH=./data/state.db

# ========== API Security ==========
# REQUIRED — no default. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your-secure-random-key-here
API_KEY_HEADER=X-API-Key
REQUIRE_API_KEY=true
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ========== Rate Limiting ==========
ENABLE_RATE_LIMIT=true
RATE_LIMIT_REQUESTS_PER_MINUTE=20

# ========== Ingestion Pipeline ==========
INGESTION_SCHEDULE_INTERVAL_HOURS=24
CRAWLER_RATE_LIMIT_REQUESTS_PER_SECOND=2.0
CRAWLER_TIMEOUT_SECONDS=30
CRAWLER_MAX_RETRIES=3
CRAWLER_USER_AGENT="Mozilla/5.0 (German-Visa-RAG/1.0)"
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PAGES_PER_DOMAIN=100
CRAWLER_RESPECT_ROBOTS_TXT=true
CRAWLER_DISCOVERY_ENABLED=true
DISCOVERY_CACHE_TTL_HOURS=168
ENABLE_INTERNAL_SCHEDULER=false

# ========== Chunking Configuration ==========
CHUNK_SIZE=512
CHUNK_OVERLAP=64
PARENT_CHUNK_SIZE=2048

# ========== Retrieval & RAG Optimization ==========
RETRIEVAL_TOP_K_HYBRID=20
RETRIEVAL_TOP_K_RERANKED=10
RETRIEVAL_DENSE_WEIGHT=0.7
RETRIEVAL_SPARSE_WEIGHT=0.3
ENABLE_QUERY_EXPANSION=true

# Authority Boosts
RAG_AUTHORITY_BOOST_OFFICIAL=1.2
RAG_AUTHORITY_BOOST_SEMI=1.0
RAG_AUTHORITY_BOOST_THIRD_PARTY=0.8

# Recency Penalties
RAG_RECENCY_PENALTY_MAX=0.1
RAG_RECENCY_PENALTY_DAYS=365

# ========== Reranker Configuration ==========
RERANKER_API_TYPE=mock
RERANKER_API_KEY=
RERANKER_MODEL_NAME=rerank-english-v2.0

# ========== MLflow Tracking ==========
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=german-visa-rag
ENABLE_MLFLOW=true

# ========== Observability ==========
ENABLE_STRUCTURED_LOGGING=true
ENABLE_PROMETHEUS=false

# ========== Paths ==========
SEED_URLS_PATH=src/ingestion/seed_urls.yml
LOGS_DIR=./logs

# ========== Deployment (GCP Cloud Run) ==========
GCP_PROJECT_ID=
GCP_REGION=europe-west1
GCP_CLOUD_RUN_SERVICE_NAME=german-visa-rag-api
GOOGLE_APPLICATION_CREDENTIALS=
